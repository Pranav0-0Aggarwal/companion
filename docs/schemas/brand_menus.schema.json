{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://companion.local/schemas/brand_menus.schema.json",
  "title": "Companion brand menus",
  "type": "object",
  "required": ["version", "chains"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "chains": { "type": "array", "items": { "$ref": "#/$defs/chain" } }
  },
  "$defs": {
    "macro": { "type": "number", "minimum": 0 },
    "chain": {
      "type": "object",
      "required": ["name", "source", "as_of", "items"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "source": { "type": "string", "description": "Where the published nutrition came from; required once items exist" },
        "as_of": { "type": "string", "description": "Date the menu was captured, YYYY-MM-DD; required once items exist" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      },
      "if": { "properties": { "items": { "minItems": 1 } } },
      "then": {
        "properties": {
          "source": { "minLength": 1 },
          "as_of": { "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "item": {
      "type": "object",
      "required": ["name", "kcal"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "aliases": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "size": { "type": "string", "description": "small, medium or large (regular, tall, grande, venti and chhota/bada are accepted); one entry per size, kcal is per one serving of that size" },
        "kcal": { "$ref": "#/$defs/macro" },
        "protein": { "$ref": "#/$defs/macro" },
        "carbs": { "$ref": "#/$defs/macro" },
        "fat": { "$ref": "#/$defs/macro" },
        "serve": { "type": "number", "exclusiveMinimum": 0, "description": "Serving weight in grams, informational" },
        "addons": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "kcal"],
            "additionalProperties": false,
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "kcal": { "type": "number" }
            }
          }
        }
      }
    }
  }
}
