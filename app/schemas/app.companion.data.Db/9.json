          "CREATE TRIGGER IF NOT EXISTS room_fts_content_sync_items_fts_AFTER_INSERT AFTER INSERT ON `items` BEGIN INSERT INTO `items_fts`(`docid`, `title`, `merchant`, `note`, `bank`, `category`, `body`) VALUES (NEW.`rowid`, NEW.`title`, NEW.`merchant`, NEW.`note`, NEW.`bank`, NEW.`category`, NEW.`body`); END"
